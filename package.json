{
  "name": "himateja.com",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.3.13",
  "engines": {
    "node": ">=22.x"
  },
  "scripts": {
    "dev": "concurrently \"contentlayer2 dev\" \"next dev\"",
    "build": "contentlayer2 build && next build",
    "start": "next start",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix && bun run format",
    "lint:strict": "eslint --max-warnings=0 src",
    "typecheck": "tsc --noEmit --incremental false",
    "format": "prettier -w .",
    "format:check": "prettier -c .",
    "push-release": "git push --follow-tags origin main",
    "postbuild": "next-sitemap --config next-sitemap.config.js",
    "prepare": "husky"
  },
  "dependencies": {
    "clsx": "^1.2.1",
    "concurrently": "^10.0.5",
    "contentlayer2": "0.5.8",
    "geist": "1.7.2",
    "gsap": "^3.15.0",
    "next": "16.3.4",
    "next-contentlayer2": "0.5.8",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-tippy": "^1.4.0",
    "rehype-autolink-headings": "^6.1.1",
    "rehype-pretty-code": "^0.10.0",
    "rehype-slug": "^5.1.0",
    "remark-gfm": "^4.0.1",
    "shiki": "^0.14.3",
    "tailwind-merge": "^1.14.0"
  },
  "devDependencies": {
    "@types/node": "20.4.1",
    "@types/react": "19",
    "@types/react-dom": "19",
    "autoprefixer": "^10.4.14",
    "eslint": "9",
    "eslint-config-next": "16.3.4",
    "eslint-config-prettier": "10",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-simple-import-sort": "12",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.6",
    "next-sitemap": "^4.2.3",
    "postcss": "^8.4.26",
    "prettier": "^3.0.0",
    "sass": "^1.63.6",
    "tailwindcss": "^3.3.3",
    "typescript": "5.9",
    "typescript-plugin-css-modules": "^5.0.1"
  },
  "lint-staged": {
    "app/**/*.{js,jsx,ts,tsx}": [
      "eslint --max-warnings=0",
      "prettier -w"
    ],
    "src/**/*.{js,jsx,ts,tsx}": [
      "eslint --max-warnings=0",
      "prettier -w"
    ],
    "src/**/*.{json,css,scss,md}": [
      "prettier -w"
    ],
    "app/**/*.{json,css,scss,md}": [
      "prettier -w"
    ]
  },
  "license": "MIT"
}
